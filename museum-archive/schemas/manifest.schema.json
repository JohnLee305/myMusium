{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifacts/[a-z0-9][a-z0-9-]{0,63}/artifact\\.json$"
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^artifacts/[a-z0-9][a-z0-9-]{0,63}/artifact\\.json$"
            },
            "maxItems": 30
          },
          "theme": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backWall": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "frontWall": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "leftWall": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "rightWall": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "floor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "background": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "plinth": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "cap": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "plaqueBackground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "plaqueBorder": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "plaqueText": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "plaqueHint": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "signBackground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "signBorder": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "signText": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "signAccent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "signMount": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "detailBackground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "detailText": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "detailAccent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "light": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "ambient": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          },
          "cells": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            }
          }
        },
        "required": [
          "id",
          "title",
          "artifacts"
        ]
      },
      "maxItems": 1000
    },
    "trash": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "roomId",
          "cell",
          "deletedAt"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "pattern": "^artifacts/[a-z0-9][a-z0-9-]{0,63}/artifact\\.json$"
          },
          "roomId": {
            "type": "string"
          },
          "cell": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29
          },
          "deletedAt": {
            "type": "string"
          }
        }
      }
    }
  }
}
