{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Museum decor slice 1: contract fixture envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "#/definitions/catalog"
    },
    "world": {
      "$ref": "#/definitions/world"
    }
  },
  "required": [
    "catalog",
    "world"
  ],
  "definitions": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "vec": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "itemRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "$ref": "#/definitions/version"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "centerM": {
          "$ref": "#/definitions/vec"
        },
        "sizeM": {
          "$ref": "#/definitions/size"
        }
      },
      "required": [
        "centerM",
        "sizeM"
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "centerM": {
          "$ref": "#/definitions/vec"
        },
        "sizeXZ": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "centerM",
        "sizeXZ"
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "id",
        "label",
        "colorHex"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "$ref": "#/definitions/version"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "floorFurniture",
            "surfaceDecor"
          ]
        },
        "dimensionsM": {
          "$ref": "#/definitions/size"
        },
        "collision": {
          "$ref": "#/definitions/box"
        },
        "supports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/surface"
          },
          "maxItems": 8
        },
        "snapM": {
          "enum": [
            0.25,
            0.05
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variant"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "kind",
        "dimensionsM",
        "collision",
        "supports",
        "snapM",
        "variants"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "#/definitions/id"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "revision",
        "items"
      ]
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bounds": {
          "$ref": "#/definitions/box"
        },
        "reservedZones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/box"
          },
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "name",
        "bounds",
        "reservedZones"
      ]
    },
    "roomLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "room"
        },
        "roomId": {
          "$ref": "#/definitions/id"
        },
        "positionM": {
          "$ref": "#/definitions/vec"
        },
        "yawDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      },
      "required": [
        "kind",
        "roomId",
        "positionM",
        "yawDeg"
      ]
    },
    "parentLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "parent"
        },
        "parentId": {
          "$ref": "#/definitions/id"
        },
        "surfaceId": {
          "$ref": "#/definitions/id"
        },
        "localPositionM": {
          "$ref": "#/definitions/vec"
        },
        "yawDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      },
      "required": [
        "kind",
        "parentId",
        "surfaceId",
        "localPositionM",
        "yawDeg"
      ]
    },
    "storageLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "storage"
        }
      },
      "required": [
        "kind"
      ]
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/definitions/roomLocation"
        },
        {
          "$ref": "#/definitions/parentLocation"
        },
        {
          "$ref": "#/definitions/storageLocation"
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "definition": {
          "$ref": "#/definitions/itemRef"
        },
        "variantId": {
          "$ref": "#/definitions/id"
        },
        "location": {
          "$ref": "#/definitions/location"
        }
      },
      "required": [
        "id",
        "definition",
        "variantId",
        "location"
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "decor-slice-1"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "catalogRevision": {
          "$ref": "#/definitions/id"
        },
        "lastCommandBatchId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/room"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/instance"
          },
          "maxItems": 512
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "catalogRevision",
        "lastCommandBatchId",
        "rooms",
        "instances"
      ]
    }
  }
}
